# Copie para bench-agent.env (na mesma pasta) e preencha.
APP_URL=https://consertos-pro.vercel.app
# Mesmo valor configurado na Vercel em BENCH_AGENT_TOKEN
BENCH_AGENT_TOKEN=
# Nome que aparece no app ("Agente da bancada online (...)")
AGENT_NAME=Bancada 1

# ezp2023 | simulado | flashrom | minipro
DRIVER=ezp2023

# EZP2023+ (modo assistido: o tecnico usa o programa do EZP2023 e salva os .bin nesta pasta)
EZP_PASTA=C:\ConsertosPro-EZP
# Minutos que o agente espera cada arquivo
EZP_ESPERA_MIN=20
# Opcional: nome do chip que aparece no caso (ex.: W25Q64)
EZP_CHIP=

# flashrom (CH341A e outros)
FLASHROM_PATH=C:\flashrom\flashrom.exe
FLASHROM_PROGRAMMER=ch341a_spi
# So se o flashrom disser que mais de um modelo combina (ex.: W25Q64BV/W25Q64CV/W25Q64FV)
FLASHROM_CHIP=

# minipro (XGecu T48 / T56 / TL866II+)
MINIPRO_PATH=C:\minipro\minipro.exe
MINIPRO_CHIP=W25Q64BV@SOIC8

# simulado (teste sem gravador): arquivo que faz o papel do chip
SIM_CHIP_FILE=

POLL_MS=3000
